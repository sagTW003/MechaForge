	"descripcion": "Integrados DIP que cruzan el canal central: el Nano (USB) alimenta los rieles, el 555 astable hace parpadear el LED rojo y el programa (d2, d13) el LED verde. Pulsa ▶ Simular.",
	"entorno": 0,
	"formato": "mechaforge",
	"grid_mm": 10.0,
	"microcontrolador": {
		"activo": true,
		"script": "# Arduino Nano: el LED «L» (D13) y el LED verde (D2)\n# parpadean a 1 Hz; el LED rojo lo hace oscilar el NE555.\nd13 = floor(fmod(t * 2, 2))\nd2 = d13\nd13",
		"union": -1
	},
