<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuente NuGet local con los paquetes de Godot (Godot.NET.Sdk, GodotSharp).
  Vienen incluidos en el editor .NET de Godot; así la restauración funciona
  sin depender de la red. Ajusta la ruta si mueves la carpeta del editor.
-->
<configuration>
  <packageSources>
    <add key="GodotLocal" value="../tools/godot/Godot_v4.7.2-stable_mono_win64/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
