<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquetes de Godot (Godot.NET.Sdk, GodotSharp, Godot.SourceGenerators 4.7.2)
  desde nuget.org, igual en cualquier equipo. <clear/> ignora las fuentes que
  tenga configuradas cada máquina, para que la restauración sea reproducible.
  Sin conexión se usan los que ya estén en la caché de NuGet.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
